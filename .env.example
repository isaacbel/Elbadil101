# Local SQLite database path (default) or remote Turso/LibSQL URL
DATABASE_PATH=./data/campaign.db
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# Primary admin credentials
ADMIN_EMAIL=admin@candidate.dz
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_PASSWORD_HASH=
ADMIN_ROLE=super_admin

# Session encryption secret (generate with `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-64-character-random-hex-string
